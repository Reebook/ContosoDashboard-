{
    "Logging":  {
                    "LogLevel":  {
                                     "Default":  "Information",
                                     "Microsoft.AspNetCore":  "Warning"
                                 }
                },
    "AllowedHosts":  "*",
    "ConnectionStrings":  {
                              "DefaultConnection":  "Server=(localdb)\\mssqllocaldb;Database=ContosoDashboard;Trusted_Connection=True;MultipleActiveResultSets=true"
                          },
    "AzureAd":  {
                    "Instance":  "https://login.microsoftonline.com/",
                    "Domain":  "contoso.onmicrosoft.com",
                    "TenantId":  "your-tenant-id",
                    "ClientId":  "your-client-id",
                    "CallbackPath":  "/signin-oidc"
                },
    "Documents":  {
                      "MaxFileSizeBytes":  26214400,
                      "AllowedExtensions":  [
                                                ".pdf",
                                                ".doc",
                                                ".docx",
                                                ".xls",
                                                ".xlsx",
                                                ".ppt",
                                                ".pptx",
                                                ".txt",
                                                ".jpg",
                                                ".jpeg",
                                                ".png"
                                            ],
                      "AuditRetentionDays":  null,
                      "Storage":  {
                                      "Provider":  "Azure",
                                      "AccountUri":  "",
                                      "QuarantineContainer":  "document-quarantine",
                                      "CleanContainer":  "documents",
                                      "LocalPath":  "App_Data/documents"
                                  },
                      "Scanner":  {
                                      "Provider":  "Defender",
                                      "PollIntervalSeconds":  30,
                                      "MaxPendingAgeHours":  24
                                  }
                  }
}
